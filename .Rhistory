log_DIC_mM_std, log_Cl_uM_std, log_Ca_uM_std, log_Mg_uM_std,
log_SO4_uM_std, log_Na_uM_std, log_K_uM_std)
pca_result <- prcomp(scaled_blm_predict, center = TRUE, scale. = TRUE)
pca_result
pca_summary <- summary(pca_result)
pca_summary
