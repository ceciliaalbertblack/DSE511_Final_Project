library(readr)
library(dplyr)
library(stringr)
library(ggplot2)
library(lubridate)
# Import
outbreak_df <- read_csv("C:/Users/q4q/repos/DSE511_Final_Project/Raw data/NORS_outbreaks.csv")
# Convert to dataframe for easy handling
outbreak_df <- as.data.frame(outbreak_df)
# Preview
head(outbreak_df)
# Structure
str(outbreak_df)
library(skimr)
skim(outbreak_df)
unique(outbreak_df$State)
# Table of unique primary modes
table(outbreak_df$`Primary Mode`)
# Number of unique etiologies
n_distinct(outbreak_df$Etiology)
# Top 10 Etiologies
outbreak_df %>%
count(Etiology, sort = TRUE)%>%
head(20)
# Number of unique variables
n_distinct(outbreak_df$`Serotype or Genotype`)
# Number of unique variables
n_unique(outbreak_df$`Etiology Status`)
# Top 10 unique names
unique(outbreak_df$`Etiology Status`)%>%
head(10)   # top 10
n_unique(outbreak_df$Setting)
# Top 10 food vehicles by rank
outbreak_df %>%
count(`Food Vehicle`, sort = TRUE) %>%
head(10)
outbreak_df %>%
mutate(
FoodVehicle_missing = if_else(
is.na(`Food Vehicle`) | `Food Vehicle` == "", "Missing", "Present")) %>%
count(`Primary Mode`, FoodVehicle_missing) %>%
group_by(`Primary Mode`) %>%
mutate(percent = 100 * n / sum(n)) %>%
ungroup()
# Number of unique variables
n_unique(outbreak_df$`Food Contaminated Ingredient`)
unique(outbreak_df$`IFSAC Category`)
outbreak_df %>%
group_by(`Primary Mode`) %>%
summarize(
total = n(),
missing_IFSAC = sum(is.na(`IFSAC Category`)),
percent_missing = 100 * missing_IFSAC / total
) %>%
arrange(desc(percent_missing))
# Top 10 water exposure types by rank
outbreak_df %>%
count(`Water Exposure`, sort = TRUE)
outbreak_df %>%
mutate(
Waterexposure_missing = if_else(
is.na(`Water Exposure`) | `Water Exposure` == "", "Missing", "Present")) %>%
count(`Primary Mode`, Waterexposure_missing) %>%
group_by(`Primary Mode`) %>%
mutate(percent = 100 * n / sum(n)) %>%
ungroup()
n_unique(outbreak_df$`Water Type`)
# Top 10 water types by rank
outbreak_df %>%
count(`Water Type`, sort = TRUE)%>%
head(10)
# Top 10 animal types by rank
outbreak_df %>%
count(`Animal Type`, sort = TRUE) %>%
head(10)
outbreak_df <- outbreak_df %>%
mutate(Animal_group = case_when(
is.na(`Animal Type`) ~ "Missing/NA",
str_detect(`Animal Type`, ";") ~ "Multiple",  # catches multi-animal entries
str_detect(`Animal Type`, regex("poultry", ignore_case = TRUE)) ~ "Poultry",
str_detect(`Animal Type`, regex("cattle", ignore_case = TRUE)) ~ "Cattle",
str_detect(`Animal Type`, regex("cat|dog|ferret|guinea pig|hedgehog|mouse|rat|raccoon", ignore_case = TRUE)) ~ "House Pets",
str_detect(`Animal Type`, regex("horse|pony|goat|sheep|pig|alpaca|donkey|llama|yak", ignore_case = TRUE)) ~ "Other Ungulates",
str_detect(`Animal Type`, regex("lizard|turtle|snake|reptile", ignore_case = TRUE)) ~ "Reptiles",
str_detect(`Animal Type`, regex("bird, not including poultry", ignore_case = TRUE)) ~ "Other Birds",
str_detect(`Animal Type`, regex("fish", ignore_case = TRUE)) ~ "Fish",
str_detect(`Animal Type`, regex("frog|salamander", ignore_case = TRUE)) ~ "Amphibians",
str_detect(`Animal Type`, regex("other", ignore_case = TRUE)) ~ "Other/Unknown",
TRUE ~ "Other/Unknown"
))
# Check the counts for each group
outbreak_df %>%
count(Animal_group, sort = TRUE)
# Check if any years are missing
sum(is.na(outbreak_df$Year))
# Count of outbreaks per year
# Visualize number of outbreaks per year
barplot(table(outbreak_df$Year),
main = "Number of Outbreaks per Year",
xlab = "Year",
ylab = "Count of Outbreaks",
col = "steelblue",
border = NA)
# Check if any months are missing within each year
missing_months_by_year <- outbreak_df %>%
filter(!is.na(Year)) %>%
group_by(Year) %>%
summarize(
observed_months = sort(unique(Month)),
missing_months = list(setdiff(1:12, unique(Month))),
n_missing = length(setdiff(1:12, unique(Month)))
) %>%
filter(n_missing > 0)
missing_months_by_year
# Visualize this using a heatmap
ggplot(outbreak_df, aes(x = Month, y = factor(Year))) +
geom_tile(aes(fill = !is.na(Month)), color = "white") +
scale_fill_manual(values = c("FALSE" = "grey90", "TRUE" = "steelblue")) +
labs(title = "Month Coverage by Year",
x = "Month",
y = "Year",
fill = "Data Present") +
theme_minimal()
# Frequency of outbreaks by month across all years
month_freq <- outbreak_df %>%
filter(!is.na(Month)) %>%
count(Month, sort = TRUE)
month_freq
# Visualization of frequency of outbreaks by month across all years
ggplot(outbreak_df, aes(x = factor(Month))) +
geom_bar(fill = "steelblue") +
labs(title = "Frequency of Outbreaks per Month (All Years)",
x = "Month",
y = "Number of Outbreaks") +
theme_minimal()
# Histogram of Illnesses by outbreak
hist(outbreak_df$Illnesses)
# Check for missing values
sum(is.na(outbreak_df$Illnesses))
# Check if a certain primary mode have several missing values of Illness
missing_by_primary_mode <- outbreak_df %>%
group_by(`Primary Mode`) %>%
summarize(
total = n(),
missing_illness = sum(is.na(Illnesses)),
percent_missing = 100 * missing_illness / total,
.groups = "drop"
)
# Visualize
ggplot(missing_by_primary_mode, aes(x = `Primary Mode`, y = percent_missing)) +
geom_col(fill = "green") +
labs(title = "Percentage of Missing Illnesses by Primary Mode",
x = "Primary Mode",
y = "Percent Missing (%)") +
theme_minimal()
hist(outbreak_df$Hospitalizations)
# Check for missing values
sum(is.na(outbreak_df$Hospitalizations))
range(outbreak_df$Hospitalizations, na.rm = TRUE)
unique(outbreak_df$`Info On Hospitalizations`)
hist(outbreak_df$Deaths)
# Check for missing values
sum(is.na(outbreak_df$Deaths))
hist(outbreak_df$`Info On Deaths`)
outbreak_df <- outbreak_df %>%
select(
-'Serotype or Genotype',
-'Etiology Status',
-'IFSAC Category',
-'Info On Hospitalizations',
-'Info On Deaths',
-'Food Contaminated Ingredient'
)
# Check
colnames(outbreak_df)
outbreak_df <- outbreak_df %>%
mutate(
`Food Vehicle` =
case_when(
is.na(`Food Vehicle`) &
str_detect(`Primary Mode`, regex("Food", ignore_case = TRUE)) ~ "Unknown",
TRUE ~ `Food Vehicle`
),
Illnesses = if_else(is.na(Illnesses), 0, Illnesses),
Hospitalizations = if_else(is.na(Hospitalizations), 0, Hospitalizations)
Deaths = if_else(is.na(Deaths), 0, Deaths)
outbreak_df <- outbreak_df %>%
mutate(
`Food Vehicle` =
case_when(
is.na(`Food Vehicle`) &
str_detect(`Primary Mode`, regex("Food", ignore_case = TRUE)) ~ "Unknown",
TRUE ~ `Food Vehicle`
),
Illnesses = if_else(is.na(Illnesses), 0, Illnesses),
Hospitalizations = if_else(is.na(Hospitalizations), 0, Hospitalizations),
Deaths = if_else(is.na(Deaths), 0, Deaths)
)
# Check that no NAs exist in Food Vehicle when Food as Primary Mode of outbreak
outbreak_df %>%
filter(str_detect(`Primary Mode`, regex("food", ignore_case = TRUE))) %>%
summarize(
missing_food_vehicle = sum(is.na(`Food Vehicle`))
)
# Check that Unknown was successfully added as a new category of Food Vehicle for the NA values
outbreak_df %>%
count(`Food Vehicle`, sort = TRUE) %>%
head(10)
# Check that NAs in Illnesses and Deaths have been replaced by 0
outbreak_df %>%
summarize(
missing_illnesses = sum(is.na(Illnesses)),
missing_deaths = sum(is.na(Deaths))
)
# Create a Date variable which combines Month-Year
outbreak_df <- outbreak_df %>%
mutate(
Date = sprintf("%04d-%02d", Year, Month)  # formats as "YYYY-MM"
)
outbreak_df <- outbreak_df %>%
mutate(
state_abbr = state.abb[ match(State, state.name) ]
)
outbreak_df <- outbreak_df %>%
mutate(
Hospitalizations_std = scale(Hospitalizations),
Deaths_std = scale(Deaths)
)
# Preview
outbreak_df %>%
select(Hospitalizations_std, Deaths_std) %>%
head(10)
outbreak_df <- outbreak_df %>%
# Ensure numeric and replace NAs with 0
mutate(
Illnesses = as.numeric(Illnesses),
Hospitalizations = as.numeric(Hospitalizations),
Deaths = as.numeric(Deaths),
Illnesses = if_else(is.na(Illnesses), 0, Illnesses),
Hospitalizations = if_else(is.na(Hospitalizations), 0, Hospitalizations),
Deaths = if_else(is.na(Deaths), 0, Deaths),
# Create outbreak_severity as sum
outbreak_severity = Illnesses + Hospitalizations + Deaths
)
# Preview the first few rows
outbreak_df %>%
select(Illnesses, Hospitalizations, Deaths, outbreak_severity) %>%
head(10)
outbreak_df <- outbreak_df %>%
mutate(
is_food_related = if_else(str_detect(`Primary Mode`, regex("Food", ignore_case = TRUE)), 1, 0),
is_water_related = if_else(str_detect(`Primary Mode`, regex("Water", ignore_case = TRUE)), 1, 0),
is_animal_related = if_else(str_detect(`Primary Mode`, regex("Animal", ignore_case = TRUE)), 1, 0)
)
# Preview the first few rows
outbreak_df %>%
select(`Primary Mode`, is_food_related, is_water_related, is_animal_related) %>%
head(10)
outbreak_df <- outbreak_df %>%
mutate(
season = case_when(
Month %in% c(12, 1, 2) ~ "Winter",
Month %in% c(3, 4, 5)  ~ "Spring",
Month %in% c(6, 7, 8)  ~ "Summer",
Month %in% c(9, 10, 11) ~ "Fall",
TRUE ~ NA_character_  # in case Month is missing or invalid
)
)
# Preview the first few rows
outbreak_df %>%
select(Month, season) %>%
head(10)
# Define the desired column order
desired_order <- c(
"Date", "Year", "Month", "season", "State", "state_abbr",
"Primary Mode", "Etiology", "Serotype or Genotype", "IFSAC Category", "setting",
"Illnesses", "Hospitalizations", "Deaths", "outbreak_severity",
"food_vehicle_missing", "Water Exposure", "water_exposure_missing", "Water Type", "water_type_group",
"Animal Type", "animal_group",
"is_food_related", "is_water_related", "is_animal_related"
)
# Reorder columns, keeping only those that exist
outbreak_df <- outbreak_df %>%
select(any_of(desired_order))
# Preview first 10 rows
outbreak_df %>%
head(10)
# Save to CSV
write.csv(outbreak_df, "outbreak_clean_v3_r.csv", row.names = FALSE)
# Structure
str(outbreak_df)
