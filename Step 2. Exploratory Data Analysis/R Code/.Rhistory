# 1. Compute median Hosp_per_ill per state-year, then median across years per state
yearly_hosp_ratio <- clean_df %>%
group_by(State_abbr, Year) %>%
summarise(yearly_hosp_ratio = median(Hosp_per_ill, na.rm = TRUE), .groups = "drop") %>%
group_by(State_abbr) %>%
summarise(median_yearly_hosp_ratio = median(yearly_hosp_ratio, na.rm = TRUE)) %>%
arrange(desc(median_yearly_hosp_ratio)) %>%
slice_head(n = 15)
# 2. Plot top 15 states by median yearly hospitalization ratio
ggplot(
yearly_hosp_ratio,
aes(
x = reorder(State_abbr, -median_yearly_hosp_ratio),
y = median_yearly_hosp_ratio,
fill = State_abbr
)
) +
geom_col(show.legend = FALSE) +
theme_minimal(base_size = 13) +
labs(
title = "Top 15 States by Median Yearly Hospitalization Ratio (Hosp_per_ill)",
x = "State",
y = "Median Yearly Hospitalization Ratio"
)
# 3. Save plot
ggsave(
filename = "Top_15_States_by_Median_Yearly_Hosp_per_Ill.png",
width = 10, height = 5, units = "in", dpi = 300
)
