outbreak_df %>%
count(Animal_group, sort = TRUE)
# Check if any years are missing
sum(is.na(outbreak_df$Year))
# Count of outbreaks per year
# Visualize number of outbreaks per year
barplot(table(outbreak_df$Year),
main = "Number of Outbreaks per Year",
xlab = "Year",
ylab = "Count of Outbreaks",
col = "steelblue",
border = NA)
# Check if any months are missing within each year
missing_months_by_year <- outbreak_df %>%
filter(!is.na(Year)) %>%
group_by(Year) %>%
summarize(
observed_months = sort(unique(Month)),
missing_months = list(setdiff(1:12, unique(Month))),
n_missing = length(setdiff(1:12, unique(Month)))
) %>%
filter(n_missing > 0)
missing_months_by_year
# Visualize this using a heatmap
ggplot(outbreak_df, aes(x = Month, y = factor(Year))) +
geom_tile(aes(fill = !is.na(Month)), color = "white") +
scale_fill_manual(values = c("FALSE" = "grey90", "TRUE" = "steelblue")) +
labs(title = "Month Coverage by Year",
x = "Month",
y = "Year",
fill = "Data Present") +
theme_minimal()
# Frequency of outbreaks by month across all years
month_freq <- outbreak_df %>%
filter(!is.na(Month)) %>%
count(Month, sort = TRUE)
month_freq
# Visualization of frequency of outbreaks by month across all years
ggplot(outbreak_df, aes(x = factor(Month))) +
geom_bar(fill = "steelblue") +
labs(title = "Frequency of Outbreaks per Month (All Years)",
x = "Month",
y = "Number of Outbreaks") +
theme_minimal()
# Histogram of Illnesses by outbreak
hist(outbreak_df$Illnesses)
# Check for missing values
sum(is.na(outbreak_df$Illnesses))
# Check if a certain primary mode have several missing values of Illness
missing_by_primary_mode <- outbreak_df %>%
group_by(`Primary Mode`) %>%
summarize(
total = n(),
missing_illness = sum(is.na(Illnesses)),
percent_missing = 100 * missing_illness / total,
.groups = "drop"
)
# Visualize
ggplot(missing_by_primary_mode, aes(x = `Primary Mode`, y = percent_missing)) +
geom_col(fill = "green") +
labs(title = "Percentage of Missing Illnesses by Primary Mode",
x = "Primary Mode",
y = "Percent Missing (%)") +
theme_minimal()
hist(outbreak_df$Hospitalizations)
# Check for missing values
sum(is.na(outbreak_df$Hospitalizations))
range(outbreak_df$Hospitalizations, na.rm = TRUE)
unique(outbreak_df$`Info On Hospitalizations`)
hist(outbreak_df$Deaths)
# Check for missing values
sum(is.na(outbreak_df$Deaths))
hist(outbreak_df$`Info On Deaths`)
outbreak_df <- outbreak_df %>%
select(
-'Serotype or Genotype',
-'Etiology Status',
-'IFSAC Category',
-'Info On Hospitalizations',
-'Info On Deaths',
-'Food Contaminated Ingredient'
)
# Check
colnames(outbreak_df)
outbreak_df <- outbreak_df %>%
mutate(
# Food Vehicle: replace NA with "Unknown" if Primary Mode is Food
`Food Vehicle` = case_when(
is.na(`Food Vehicle`) & str_detect(`Primary Mode`, regex("Food", ignore_case = TRUE)) ~ "Unknown",
TRUE ~ `Food Vehicle`
),
# Illnesses: replace NA with 0
Illnesses = if_else(is.na(Illnesses), 0, Illnesses),
# Deaths: replace NA with 0
Deaths = if_else(is.na(Deaths), 0, Deaths)
)
# Check that no NAs exist in Food Vehicle when Food as Primary Mode of outbreak
outbreak_df %>%
filter(str_detect(`Primary Mode`, regex("food", ignore_case = TRUE))) %>%
summarize(
missing_food_vehicle = sum(is.na(`Food Vehicle`))
)
# Check that Unknown was successfully added as a new category of Food Vehicle for the NA values
outbreak_df %>%
count(`Food Vehicle`, sort = TRUE) %>%
head(10)
# Check that NAs in Illnesses and Deaths have been replaced by 0
outbreak_df %>%
summarize(
missing_illnesses = sum(is.na(Illnesses)),
missing_deaths = sum(is.na(Deaths))
)
# Create a Date variable which combines Month-Year
outbreak_df <- outbreak_df %>%
mutate(
Date = sprintf("%04d-%02d", Year, Month)  # formats as "YYYY-MM"
)
outbreak_df <- outbreak_df %>%
mutate(
state_abbr = state.abb[ match(State, state.name) ]
)
outbreak_df <- outbreak_df %>%
mutate(
Hospitalizations_std = scale(Hospitalizations),
Deaths_std = scale(Deaths)
)
outbreak_df %>%
select(Hospitalizations_std, Deaths_std) %>%
head(10)
