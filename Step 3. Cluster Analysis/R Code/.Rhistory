library(readr)
library(tidyverse)
library(fitdistrplus)
library(factoextra) #for pca
library(klaR) # K-modes clustering
library(psych) # for KMO test
clean_df <- read_csv("C:/Users/q4q/repos/DSE511_Final_Project/Step 1. Data Cleaning/R code/outbreak_clean_r_v3.csv")
head(clean_df)
cat_vars <- c(
"Date",
"Season",
"Region",
"Primary_mode",
"Setting_group",
"Etiology_group"
)
kmodes_df <- clean_df %>%
dplyr::select(all_of(cat_vars)) %>%
mutate(
across(everything(), as.factor)
)
# sanity check
dim(kmodes_df)
names(kmodes_df)
summary(is.na(kmodes_df))
kmodes_input <- as.data.frame(kmodes_df)
# 4 clusters
kmodes_result_2 <- klaR::kmodes(
kmodes_input,
modes = 2,
iter.max = 50
)
table(kmodes_result_2$cluster)
kmodes_result_2$modes
# Add cluster labels to the kmodes_input data
kmodes_clusters_2 <- factor(kmodes_result_2$cluster)
kmodes_df_2 <- kmodes_input %>%
mutate(cluster = kmodes_clusters_2)
# Quick look at cluster sizes
kmodes_df_2 %>%
count(cluster)
library(ggplot2)
library(dplyr)
# Helper function
plot_cluster_comp <- function(data, var_name) {
ggplot(
data,
aes(x = .data[[var_name]], fill = cluster)
) +
geom_bar(position = "fill") +           # proportion within each category
coord_flip() +
theme_minimal(base_size = 12) +
labs(
title = paste("Cluster Composition by", var_name),
x = var_name,
y = "Proportion"
) +
theme(
legend.position = "bottom",
axis.text.y = element_text(size = 8)
)
}
# By state
plot_cluster_comp(kmodes_df_2, "State")
